# BuildCommand AI — Owner Console Service
# Separate container entry point for the private Owner service.
# The existing ./Dockerfile remains untouched for the live main app.

FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

CMD ["sh", "-c", "uvicorn owner_app:app --host 0.0.0.0 --port ${PORT:-10000}"]
